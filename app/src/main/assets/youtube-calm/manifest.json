{
  "manifest_version": 2,
  "name": "AIR YouTube without recommendations, with Korean captions",
  "version": "1.3",
  "browser_specific_settings": {
    "gecko": {
      "id": "youtube-calm@air.local"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://m.youtube.com/*",
        "https://www.youtube.com/*",
        "https://youtube.com/*"
      ],
      "css": [
        "hide.css"
      ],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": [
        "https://m.youtube.com/*",
        "https://www.youtube.com/*",
        "https://youtube.com/*"
      ],
      "js": [
        "captions.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
