{
  "manifest_version": 2,
  "name": "AIR SMS sign-in assistant",
  "version": "2.5",
  "browser_specific_settings": { "gecko": { "id": "sms-assist@air.local" } },
  "permissions": ["nativeMessaging", "nativeMessagingFromContent", "geckoViewAddons"],
  "content_scripts": [{
    "matches": ["https://*/*", "http://localhost/*", "http://127.0.0.1/*"],
    "js": ["fields.js", "content.js"],
    "run_at": "document_idle",
    "all_frames": false
  }]
}
