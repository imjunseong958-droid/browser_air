<?xml version="1.0" encoding="utf-8"?>
<!-- The tab showing now is selected and drawn in mint; the others are sage. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="@color/mint_pressed">
    <item>
        <selector>
            <item android:state_selected="true">
                <shape>
                    <solid android:color="@color/mint" />
                    <stroke android:width="1.5dp" android:color="@color/accent" />
                    <corners android:radius="16dp" />
                </shape>
            </item>
            <item>
                <shape>
                    <solid android:color="@color/sage" />
                    <corners android:radius="16dp" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
