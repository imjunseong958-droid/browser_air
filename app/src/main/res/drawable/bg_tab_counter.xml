<?xml version="1.0" encoding="utf-8"?>
<!-- The tab counter floats over pages, so it is ink with a light rim that shows on dark and light pages alike. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="@color/ink_pressed">
    <item>
        <shape>
            <solid android:color="#E61F3A32" />
            <stroke android:width="1.5dp" android:color="#4DFFFFFF" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</ripple>
