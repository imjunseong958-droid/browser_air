<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/paper">

    <com.journeyapps.barcodescanner.BarcodeView android:id="@+id/barcodeView" android:layout_width="match_parent" android:layout_height="match_parent" />
    <dev.air.browser.ScanFrameView android:layout_width="match_parent" android:layout_height="match_parent" android:importantForAccessibility="no" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="top" android:orientation="vertical" android:padding="24dp" android:background="#E6F6F5F0">
        <ImageButton android:id="@+id/closeButton" android:layout_width="48dp" android:layout_height="48dp" android:layout_gravity="end" android:background="?attr/selectableItemBackgroundBorderless" android:src="@drawable/ic_close" android:contentDescription="@string/close" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/scanner_title" android:textColor="@color/ink" android:textSize="25sp" android:fontFamily="sans-serif-medium" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/scanner_body" android:textColor="@color/muted" android:textSize="13sp" />
    </LinearLayout>

    <Button android:id="@+id/torchButton" style="@style/Air.PrimaryButton" android:layout_width="wrap_content" android:layout_height="56dp" android:layout_gravity="bottom|center_horizontal" android:layout_marginBottom="40dp" android:text="@string/torch_on" />
</FrameLayout>
