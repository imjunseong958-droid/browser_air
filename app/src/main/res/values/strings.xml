    <string name="app_name">AIR</string>
    <string name="brand_descriptor">필요한 연결만, AIR</string>
    <string name="home_eyebrow">A LITTLE SPACE FOR YOU</string>
    <string name="home_title">잠깐 연결하고,\n다시 일상으로.</string>
    <string name="home_body">필요한 링크는 열어두고,\n끝없는 탐색은 내려놓으세요.</string>
    <string name="scan_qr">QR 코드 스캔</string>
