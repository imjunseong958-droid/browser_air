<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Air" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowBackground">@color/paper</item>
        <item name="android:colorAccent">@color/ink</item>
        <item name="colorAccent">@color/ink</item>
        <item name="colorControlActivated">@color/ink</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:textViewStyle">@style/Air.Text</item>
        <item name="alertDialogTheme">@style/Air.AlertDialog</item>
    </style>

    <!-- Korean text breaks between phrases instead of inside a word on Android 13 and later (values-v33). -->
    <style name="Air.Text" parent="android:Widget.TextView" />

    <style name="Air.PrimaryButton" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/bg_primary_button</item>
        <item name="android:textColor">@color/paper</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>
    <style name="Air.TonalButton" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/bg_tonal_button</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:minHeight">40dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>
    <style name="Air.SearchPill" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/bg_search_pill</item>
        <item name="android:gravity">start|center_vertical</item>
        <item name="android:textColor">@color/muted</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:drawablePadding">12dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="Air.AlertDialog" parent="ThemeOverlay.AppCompat.Dialog.Alert">
        <item name="android:windowBackground">@drawable/bg_dialog</item>
        <item name="android:backgroundDimAmount">0.32</item>
        <item name="colorAccent">@color/ink</item>
        <item name="colorControlActivated">@color/ink</item>
        <item name="android:textColorPrimary">@color/ink</item>
        <item name="android:windowTitleStyle">@style/Air.DialogTitle</item>
        <item name="android:textViewStyle">@style/Air.Text</item>
        <item name="buttonBarPositiveButtonStyle">@style/Air.DialogButton</item>
        <item name="buttonBarNegativeButtonStyle">@style/Air.DialogButton.Quiet</item>
        <item name="buttonBarNeutralButtonStyle">@style/Air.DialogButton.Quiet</item>
    </style>
    <style name="Air.DialogTitle" parent="">
        <item name="android:textAppearance">@style/Air.DialogTitleText</item>
    </style>
    <style name="Air.DialogTitleText" parent="TextAppearance.AppCompat.Title">
        <item name="android:textColor">@color/ink</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="Air.DialogButton" parent="Widget.AppCompat.Button.ButtonBar.AlertDialog">
        <item name="android:textColor">@color/ink</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    <style name="Air.DialogButton.Quiet">
        <item name="android:textColor">@color/muted</item>
    </style>

    <!-- The home search floats near the top over a dimmed, blurred home screen, like a spotlight search. -->
    <style name="Air.Spotlight" parent="Theme.AppCompat.Light.Dialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="windowNoTitle">true</item>
        <item name="android:backgroundDimAmount">0.3</item>
        <item name="android:windowAnimationStyle">@style/Air.SpotlightAnimation</item>
        <item name="colorAccent">@color/ink</item>
        <item name="colorControlActivated">@color/ink</item>
        <item name="android:textViewStyle">@style/Air.Text</item>
    </style>
    <style name="Air.SpotlightAnimation" parent="">
        <item name="android:windowEnterAnimation">@anim/spotlight_in</item>
        <item name="android:windowExitAnimation">@anim/spotlight_out</item>
    </style>
</resources>
